# App bot riêng trên Lark Developer Console (open.larksuite.com)
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
# lark | feishu
LARK_DOMAIN=lark

# open_id của anh TRONG APP NÀY (open_id khác nhau giữa các app).
# Để trống → DM bot 1 tin, bot sẽ trả về open_id để điền vào đây.
OWNER_OPEN_IDS=

# Số tin nhắn gần nhất lấy làm bối cảnh khi mention trong nhóm
GROUP_CONTEXT_LIMIT=30
# Đóng process Brain của chat sau N phút idle (session vẫn resume được)
BRAIN_IDLE_MINUTES=30
# Model cho Brain, để trống = theo settings của Claude Code
BRAIN_MODEL=
# Effort cho Brain: low | medium | high | xhigh | max — để trống = theo settings của Claude Code
BRAIN_EFFORT=high

# ─── Kênh it@ (account Lark cá nhân qua Lark web — vào được nhóm external) ───
# user id NỘI BỘ của Lark (khác open_id) của người được ra lệnh, cách nhau dấu phẩy.
# Để trống = tắt kênh. Setup: npm run it:setup && npm run it:login
IT_OWNER_IDS=
# Python của venv chạy larkx, để trống = .venv-it/bin/python
IT_PYTHON=
