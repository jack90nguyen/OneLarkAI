{
  "name": "onelark-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cầu nối Lark Bot ↔ Claude Code session (trợ lý điều phối)",
  "bin": {
    "onelark": "src/cli.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/daemon.ts",
    "typecheck": "tsc --noEmit",
    "it:setup": "python3.12 -m venv .venv-it && .venv-it/bin/pip install 'larkx @ git+https://github.com/cv-cat/LarkAgentX@97ad48e69e34bd8c78ee30f795b7c3759dd81659'",
    "it:login": "LARKX_HOME=data/larkx .venv-it/bin/lark auth qr --region lark"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
